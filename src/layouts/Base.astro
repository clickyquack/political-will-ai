---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = site.description, wide = false } = Astro.props;
const documentTitle = title === site.name ? site.name : `${title} · ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{documentTitle}</title>
  </head>
  <body class:list={{ "is-wide": wide }}>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content" class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
