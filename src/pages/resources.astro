---
import Catalog from "../components/Catalog.astro";
import PageHeader from "../components/PageHeader.astro";
import { parseCatalog } from "../lib/catalog";
import Base from "../layouts/Base.astro";
import misc from "../data/misc.json";
import newsletters from "../data/newsletters.json";
import politicianPositions from "../data/politician-positions.json";
import proxyMeasures from "../data/proxy-measures.json";
import readingList from "../data/reading-list.json";

const readingItems = parseCatalog(readingList, { pinPriority: true });
const readingGroups = [
  "Why work on political will?",
  "General political strategy-to-action thinking",
  "Working with/talking to policymakers",
  "Grassroots",
  "Funding/donations",
  "Comms",
  "Governance proposals",
].map((name) => ({ name, items: readingItems.filter((item) => item.group === name) }));

const sections = [
  { id: "reading-list", label: "Reading list", items: readingItems, pinPriority: true },
  { id: "politician-positions", label: "Politician positions", items: parseCatalog(politicianPositions, { pinPriority: true }), pinPriority: true },
  { id: "proxy-measures", label: "Proxy measures", items: parseCatalog(proxyMeasures, { pinPriority: true }), pinPriority: true },
  { id: "newsletters", label: "Newsletters", items: parseCatalog(newsletters, { pinPriority: true }), pinPriority: true },
  { id: "misc", label: "Misc", items: parseCatalog(misc, { pinPriority: true }), pinPriority: true },
];
---

<Base title="Resources" wide>
  <PageHeader title="Resources" />
  {
    sections.map((section) => (
      <details class="resource-section" id={section.id}>
        <summary>{section.label}</summary>
        {section.id === "reading-list" ? (
          readingGroups.map((group, i) => (
            <div class="resource-group">
              <h3>{group.name}</h3>
              <Catalog items={group.items} pinPriority={true} search={false} sort={false} header={i === 0} />
            </div>
          ))
        ) : (
          <Catalog items={section.items} pinPriority={section.pinPriority} search={false} sort={false} />
        )}
      </details>
    ))
  }
</Base>

<style>
  .resource-section {
    margin: 0 0 1rem;
    border-top: 1px solid var(--line);
  }

  .resource-section summary {
    padding: 0.9rem 0;
    cursor: pointer;
    font-size: 1.35rem;
    font-weight: 520;
    letter-spacing: -0.02em;
    list-style: none;
  }

  .resource-section summary::-webkit-details-marker {
    display: none;
  }

  .resource-section summary::before {
    content: "▸";
    display: inline-block;
    width: 1em;
    color: var(--accent);
    transition: transform 0.15s ease;
  }

  .resource-section[open] summary::before {
    transform: rotate(90deg);
  }

  .resource-section summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .resource-section .catalog {
    padding-bottom: 1.5rem;
  }

  .resource-group h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.3rem;
    font-weight: 600;
  }
</style>

<script>
  // Open the section named in the URL hash (e.g. /resources#newsletters from the home page).
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
    }
  }
  openFromHash();
  window.addEventListener("hashchange", openFromHash);
</script>
