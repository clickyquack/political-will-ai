---
import WarningShotTimeline from "../../components/WarningShotTimeline.astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { warningShotsTitle as title } from "../../site";
---

<Base
  title={title}
  description="A timeline of the Hugging Face incident, the Coxon coverage, and the political responses that followed."
  wide
>
  <PageHeader title={title} />
  <p class="byline accompanying-post"><a href="https://quintic.substack.com/p/measuring-the-political-impact-of">Accompanying blog post</a></p>
  <WarningShotTimeline />

<style>
  .accompanying-post {
    font-size: 1.425rem;
  }
</style>
</Base>
