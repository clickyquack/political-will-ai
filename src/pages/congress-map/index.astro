---
import PageHeader from "../../components/PageHeader.astro";
import CongressMap from "../../congress/CongressMap";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../path";
---

<Base title="AI risk in Congress" wide>
  <PageHeader title="AI risk in Congress">
    <a slot="action" class="page-header-action" href={sitePath("/congress-map/about")}>
      About this map
    </a>
  </PageHeader>
  <p class="byline">
    <strong>Notice:</strong> Data-collection for this tool is AI-assisted and although we try to catch
    them, we may have missed some mistakes.
  </p>
  <CongressMap client:load />
</Base>
