---
import PageHeader from "../../components/PageHeader.astro";
import CongressMap from "../../congress/CongressMap";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../path";
---

<Base title="AI risk in Congress" wide>
  <PageHeader title="AI risk in Congress">
    <a slot="action" class="page-header-action" href={sitePath("/congress-map/about")}>
      About this map
    </a>
  </PageHeader>
  <p class="byline">
    Where members of the incoming 120th Congress stand on AI risk and regulation, using 2026 election
    results. Races that have not been called are marked as such. Select a seat or row for sourced
    quotes and bill actions. Chip and compute security bills are tracked in the list and do not change
    a member's stance.
  </p>
  <CongressMap client:load />
</Base>
