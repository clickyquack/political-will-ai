---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../path";
import { STANCE_COLORS, STANCE_LABELS, STANCE_ORDER, type Stance } from "../../congress/lib/types";

const notes: Record<Stance, string> = {
  xrisk_concern:
    "Explicit public discussion of AGI, superintelligence, loss of control, existential risk, recursive self-improvement, or the Singularity (primarily AIPN Congress on Superintelligence), or sponsor/cosponsor of the Ban Artificial Superintelligence Act (S.5493 / H.R.10538).",
  strong_risk_reg:
    "Sponsor, cosponsor, or support for other frontier catastrophic-risk bills (for example the FRONTIER Act, AI Kill Switch Act, or RISE Act) without a public x-risk statement.",
  mundane_risk:
    "Support for addressing AI ethical concerns such as deepfakes, consumer harms, and likeness protection (for example the NO FAKES Act).",
  opposes_domestic:
    "Sourced opposition to domestic AI rulemaking (for example a state AI regulation moratorium). Does not include national-security-only measures.",
  unknown:
    "No sourced signal yet. Unknown does not mean opposed. Most members are in this category after the current research pass.",
};
---

<Base title="About the Congress map">
  <PageHeader title="About this map" />
  <p class="byline">
    <a href={sitePath("/congress-map/")}>Back to the map</a>
  </p>
  <div class="prose">
    <p>
      This is an interactive map and directory of the incoming 120th U.S. Congress, color-coded by
      publicly sourced positions on AI risk and domestic AI regulation. Seats follow called 2026
      election results as of November 4, 2026. A race that has not been called is labeled “Race not
      called” and is left blank until a winner is projected. It is a research snapshot, not a
      complete scorecard.
    </p>
    <h2>Corrections</h2>
    <p>
      If a stance, quote, bill action, or seat is wrong or missing, open an issue and include the
      member, what should change, and a public source link. Roster, quotes, bills, and actions live
      in <code>src/data/congress/</code>.
    </p>
    <p>
      <a href="https://github.com/clickyquack/political-will-ai/issues" target="_blank" rel="noreferrer">
        Open an issue on GitHub
      </a>
    </p>
    <h2>How stance is assigned</h2>
    <p>
      Each member gets one display stance. The most relevant signal is their position on long-term
      or existential AI risk. When several signals exist, the highest-priority category wins, so
      opposition to domestic AI regulation outranks support for addressing only AI ethical concerns
      such as deepfakes. Chip and compute security bills, and international governance bills, are
      tracked in the list and never move stance.
    </p>
    <ol class="stance-key">
      {
        STANCE_ORDER.map((stance, index) => (
          <li>
            <span class="swatch" style={`background:${STANCE_COLORS[stance]}`} />
            <span>
              <strong>
                {index + 1}. {STANCE_LABELS[stance]}
              </strong>
              {" — "}
              {notes[stance]}
            </span>
          </li>
        ))
      }
    </ol>
    <p>
      Display stance is recomputed from quotes, tracked bill actions, and each bill's category, so
      the map stays consistent when the underlying data is edited.
    </p>
    <h2>Map and list</h2>
    <ul>
      <li>
        <strong>Senate.</strong> By default each state is split vertically: the west half is the senior
        senator and the east half is the junior. Both, Junior, and Senior show both seats or one at a
        time. Seniority is the earlier continuous Senate start date within the state.
      </li>
      <li>
        <strong>House districts.</strong> Alabama, California, Florida, Louisiana, North Carolina,
        Ohio, Tennessee, Texas, and Utah use the district maps from the 2026 election (Census
        TIGER/Line <code>cd120</code>, simplified to the same scale as the rest of the map). Other
        states use Census cartographic boundaries for the 119th Congress
        (<code>cb_2025_us_cd119_20m</code>). Those boundaries still match the districts used there in
        2026. Missouri is in that group: its newer map was blocked in September 2026, and the election
        used the same districts as 2024. Winners are matched by state and district number.
      </li>
      <li>
        <strong>List.</strong> The same members, filterable by stance, chamber, state, party, and
        support for tracked bills (AI ethics, stronger-risk regulation, chip and compute security, and
        international AI governance). Sort by name, stance, or how many of those bills a member has
        sponsored, cosponsored, or voted for.
      </li>
    </ul>
    <p>Select a seat or row for sourced quotes and tracked bill actions with links.</p>
    <h2>Sources</h2>
    <ul>
      <li>
        Roster:{" "}
        <a href="https://unitedstates.github.io/congress-legislators/legislators-current.json">
          unitedstates/congress-legislators
        </a>
      </li>
      <li>
        X-risk quotes primarily from{" "}
        <a href="https://theaipn.org/issue/quotes/">AIPN Congress on Superintelligence</a>, plus other
        curated public statements
      </li>
      <li>
        Bills and actions: Congress.gov and press (including FRONTIER H.R.9925, Ban ASI S.5493 /
        H.R.10538, Kill Switch H.R.9917, RISE S.2081, NO FAKES S.1367 / S.4591, Chip Security S.1705,
        Future of AI Innovation S.3952)
      </li>
      <li>
        House geography: <code>public/geo/districts-120.json</code>. Redrawn states from Census
        TIGER/Line 2026 <code>cd120</code>; other states from Census <code>cb_2025_us_cd119_20m</code>
      </li>
    </ul>
    <h2>Limits</h2>
    <p>
      Many members remain unknown because no public signal has been collected yet. Former members who
      appear in AIPN quotes but are not in the current roster are omitted. Vote records are sparse for
      bills still in committee; cosponsorship is the main legislative signal used so far.
    </p>
  </div>
</Base>

<style>
  .stance-key {
    list-style: none;
    padding-left: 0;
  }

  .stance-key li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .swatch {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.45rem;
    border-radius: 3px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }
</style>
