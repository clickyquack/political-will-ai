---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../path";
import { DISPLAY_STANCE_ORDER, STANCE_COLORS, STANCE_LABELS } from "../../congress/lib/types";

/** Congress.gov bill pages (119th Congress), aligned with src/data/congress/bills.json */
const billUrl = {
  frontier: "https://www.congress.gov/bill/119th-congress/house-bill/9925",
  killSwitch: "https://www.congress.gov/bill/119th-congress/house-bill/9917",
  banAsiSenate: "https://www.congress.gov/bill/119th-congress/senate-bill/5493",
  banAsiHouse: "https://www.congress.gov/bill/119th-congress/house-bill/10538",
  noFakes2025: "https://www.congress.gov/bill/119th-congress/senate-bill/1367",
} as const;
---

<Base title="About the Congress map">
  <PageHeader title="About this map">
    <a slot="action" class="page-header-action" href={sitePath("/congress-map/")}>Back to the map</a>
  </PageHeader>
  <div class="prose">
    <p>
      This is an interactive map and directory of the incoming 120th U.S. Congress, color-coded by
      publicly sourced positions on AI risk and AI regulation.
    </p>
    <h2 id="Corrections">Corrections</h2>
    <p>
      If you find a relevant addition or correction,{" "}
      <a href="https://github.com/clickyquack/political-will-ai/issues" target="_blank" rel="noreferrer">
        open an issue in the Github repository
      </a>{" "}
      and include the correction and source link. Data is stored in{" "}
      <code>src/data/congress/</code>.
    </p>
    <h2>Stance assignment</h2>
    <p>
      Support for stronger risk regulation outranks opposition to AI regulation or light-touch-only
      approaches, which outranks support limited to AI ethical concerns such as deepfakes. Positions
      are color-coded, and existential
      risk concern is separately drawn as diagonal stripes over the color. It counts as support for
      stronger risk regulation unless there is reason to expect they would not support it, such as
      prioritizing a race against China. That is, a member can acknowledge catastrophic or existential
      risk and still be shown as opposing regulation.
      <sup id="fnref-1"><a href="#fn-1">1</a></sup> Chip and compute security bills are tracked in the
      list but do not currently move color.
    </p>
    <ol class="stance-key">
      {
        DISPLAY_STANCE_ORDER.map((stance, index) => (
          <li>
            <span class="swatch" style={`background:${STANCE_COLORS[stance]}`} />
            <span>
              <strong>
                {index + 1}. {STANCE_LABELS[stance]}
              </strong>
              {" — "}
              {stance === "strong_risk_reg" && (
                <>
                  Sponsors, cosponsors, or supports frontier catastrophic-risk bills (e.g. the{" "}
                  <a href={billUrl.frontier} target="_blank" rel="noreferrer">
                    FRONTIER Act
                  </a>
                  ,{" "}
                  <a href={billUrl.killSwitch} target="_blank" rel="noreferrer">
                    AI Kill Switch Act
                  </a>
                  , or{" "}
                  <a href={billUrl.banAsiSenate} target="_blank" rel="noreferrer">
                    Ban Artificial Superintelligence Act
                  </a>
                  ), or generally calls for addressing these risks without prioritizing racing against China.
                </>
              )}
              {stance === "mundane_risk" && (
                <>
                  Support for addressing AI ethical concerns such as deepfakes, consumer harms, etc. (e.g. the{" "}
                  <a href={billUrl.noFakes2025} target="_blank" rel="noreferrer">
                    NO FAKES Act
                  </a>
                  ).
                </>
              )}
              {stance === "opposes_domestic" && (
                <>
                  Sourced opposition to substantive AI rulemaking, or support only for light-touch
                  approaches (e.g. a state AI regulation moratorium). Does not include national-security-only
                  measures.
                </>
              )}
              {stance === "unknown" && <>No sourced signal yet on regulation.</>}
            </span>
          </li>
        ))
      }
      <li>
        <span class="swatch xrisk"></span>
        <span>
          <strong>Existential risk concern</strong>
          {" — "}
          Explicit public discussion of AGI, superintelligence, loss of control, existential risk,
          recursive self-improvement, or the Singularity, or sponsors or cosponsors the Ban Artificial
          Superintelligence Act (
          <a href={billUrl.banAsiSenate} target="_blank" rel="noreferrer">
            S.5493
          </a>{" "}
          /{" "}
          <a href={billUrl.banAsiHouse} target="_blank" rel="noreferrer">
            H.R.10538
          </a>
          ). This as support for stronger risk regulation
          unless there is reason to expect they would not support it, such as prioritizing racing
          against China.
        </span>
      </li>
    </ol>
    <p>Select a seat or row for sourced quotes and bill actions with links.</p>
    <h2>Sources</h2>
    <ul>
      <li>
        Roster:{" "}
        <a href="https://unitedstates.github.io/congress-legislators/legislators-current.json">
          unitedstates/congress-legislators
        </a>
      </li>
      <li>
        Existential risk quotes primarily from{" "}
        <a href="https://theaipn.org/issue/quotes/">AIPN Congress on Superintelligence</a>, plus other
        curated statements
      </li>
      <li>
        2026 candidate and member positions from{" "}
        <a href="https://ontheballot.ai/">AI on the Ballot</a> when applicable
      </li>
      <li>
        Some positions inferred from super PAC support as tracked by{" "}
        <a href="https://elections.transformernews.ai/">Transformer&apos;s AI Campaign Finance Tracker</a>{" "}
        when no better signal is available
      </li>
      <li>Bills and actions: Congress.gov and relevant press releases</li>
      <li>
        House geography: <code>public/geo/districts-120.json</code>. Redrawn states from Census
        TIGER/Line 2026 <code>cd120</code>; other states from Census <code>cb_2025_us_cd119_20m</code>
      </li>
    </ul>
    <p class="footnote" id="fn-1">
      <a href="#fnref-1" aria-label="Back to reference 1">↩</a> To account for positions such as{" "}
      <a
        href="https://www.politico.com/live-updates/2026/09/09/congress/ted-cruz-ai-risks-legislation-01069036"
        target="_blank"
        rel="noreferrer"
      >
        “If there are going to be killer robots, I would rather they be American killer robots, rather
        than Chinese killer robots”
      </a>
      .
    </p>
  </div>
</Base>

<style>
  .stance-key {
    list-style: none;
    padding-left: 0;
  }

  .stance-key li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .swatch {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.45rem;
    border-radius: 3px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .swatch.xrisk {
    background-color: #d7ddd8;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 2px,
      rgba(12, 28, 36, 0.55) 2px 3.5px
    );
  }

  .footnote {
    margin-top: 1.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>
