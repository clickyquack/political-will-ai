---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../path";
import { DISPLAY_STANCE_ORDER, STANCE_COLORS, STANCE_LABELS, type DisplayStance } from "../../congress/lib/types";

const notes: Record<DisplayStance, string> = {
  strong_risk_reg:
    "Sponsors, cosponsors, or supports frontier catastrophic-risk bills (for example the FRONTIER Act, AI Kill Switch Act, RISE Act, or Ban Artificial Superintelligence Act), or generally calls for addressing these risks without prioritizing racing against China.",
  mundane_risk:
    "Support for addressing AI ethical concerns such as deepfakes, consumer harms, and likeness protection (for example the NO FAKES Act).",
  opposes_domestic:
    "Sourced opposition to domestic AI rulemaking (for example a state AI regulation moratorium). Does not include national-security-only measures.",
  unknown:
    "No sourced signal yet on regulation.",
};
---

<Base title="About the Congress map">
  <PageHeader title="About this map" />
  <p class="byline">
    <a href={sitePath("/congress-map/")}>Back to the map</a>
  </p>
  <div class="prose">
    <p>
      This is an interactive map and directory of the incoming 120th U.S. Congress, color-coded by
      publicly sourced positions on AI risk and domestic AI regulation.
    </p>
    <h2>Corrections</h2>
    <p>
      If you find a relevant addition or correction,{" "}
      <a href="https://github.com/clickyquack/political-will-ai/issues" target="_blank" rel="noreferrer">
        open an issue in the Github repository
      </a>{" "}
      and include the member, correction, and source link. Roster, quotes, bills, and actions are in{" "}
      <code>src/data/congress/</code>.
    </p>
    <h2>How stance is assigned</h2>
    <p>
      Each member gets one regulation color. Support for stronger-risk regulation outranks opposition
      to domestic regulation, which outranks support limited to AI ethical concerns such as deepfakes.
      Existential-risk concern is separately drawn as diagonal stripes over the color. It counts as
      support for stronger-risk regulation unless a sourced position gives a reason to expect they
      would not support it, such as prioritizing a race against China, so a member can acknowledge
      catastrophic or existential risk and still be shown as opposing regulation.
      <sup id="fnref-1"><a href="#fn-1">1</a></sup> The stripes can be filtered on their own.
      Chip and compute security bills, and international governance bills, are tracked in the list but
      do not currently move color.
    </p>
    <ol class="stance-key">
      {
        DISPLAY_STANCE_ORDER.map((stance, index) => (
          <li>
            <span class="swatch" style={`background:${STANCE_COLORS[stance]}`} />
            <span>
              <strong>
                {index + 1}. {STANCE_LABELS[stance]}
              </strong>
              {" — "}
              {notes[stance]}
            </span>
          </li>
        ))
      }
      <li>
        <span class="swatch xrisk"></span>
        <span>
          <strong>Existential risk concern</strong>
          {" — "}
          Diagonal stripes over the regulation color. Recorded for an explicit public discussion of
          AGI, superintelligence, loss of control, existential risk, recursive self-improvement, or
          the Singularity, or for sponsoring or cosponsoring the Ban Artificial Superintelligence Act
          (S.5493 / H.R.10538). That concern counts as support for stronger-risk regulation unless a
          sourced position gives a reason to expect they would not support it, such as prioritizing a
          race against China. Sponsoring or cosponsoring the ban still counts as that support.
        </span>
      </li>
    </ol>
    <p>Select a seat or row for sourced quotes and tracked bill actions with links.</p>
    <h2>Sources</h2>
    <ul>
      <li>
        Roster:{" "}
        <a href="https://unitedstates.github.io/congress-legislators/legislators-current.json">
          unitedstates/congress-legislators
        </a>
      </li>
      <li>
        Existential risk quotes primarily from{" "}
        <a href="https://theaipn.org/issue/quotes/">AIPN Congress on Superintelligence</a>, plus other
        curated public statements
      </li>
      <li>
        2026 candidate and member positions from{" "}
        <a href="https://ontheballot.ai/">AI on the Ballot</a>, added only when the underlying source
        could be checked and the statement fits one of the stance categories above
      </li>
      <li>
        Bills and actions: Congress.gov and press (including FRONTIER H.R.9925, Ban ASI S.5493 /
        H.R.10538, Kill Switch H.R.9917, RISE S.2081, NO FAKES S.1367 / S.4591, Chip Security S.1705,
        Future of AI Innovation S.3952)
      </li>
      <li>
        House geography: <code>public/geo/districts-120.json</code>. Redrawn states from Census
        TIGER/Line 2026 <code>cd120</code>; other states from Census <code>cb_2025_us_cd119_20m</code>
      </li>
    </ul>
    <p class="footnote" id="fn-1">
      <a href="#fnref-1" aria-label="Back to reference 1">↩</a> To account for positions such as{" "}
      <a
        href="https://www.politico.com/live-updates/2026/09/09/congress/ted-cruz-ai-risks-legislation-01069036"
        target="_blank"
        rel="noreferrer"
      >
        “If there are going to be killer robots, I would rather they be American killer robots, rather
        than Chinese killer robots”
      </a>
      .
    </p>
  </div>
</Base>

<style>
  .stance-key {
    list-style: none;
    padding-left: 0;
  }

  .stance-key li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .swatch {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.45rem;
    border-radius: 3px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .swatch.xrisk {
    background-color: #d7ddd8;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 2px,
      rgba(12, 28, 36, 0.55) 2px 3.5px
    );
  }

  .footnote {
    margin-top: 1.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>
