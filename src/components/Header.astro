---
import { sitePath } from "../path";
import { isCurrent, isGroup, nav, site } from "../site";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell">
    <a class="wordmark" href={sitePath("/")}>{site.name}</a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) =>
            isGroup(item) ? (
              <li
                class:list={[
                  "nav-dropdown",
                  { "is-current": item.children.some((child) => isCurrent(pathname, child.href)) },
                ]}
              >
                <span class="nav-dropdown-label">{item.label}</span>
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isCurrent(pathname, child.href) ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>
